# ================================================
# Notification Service 環境變數配置範本
# ================================================
# 複製此檔案為 .env 並修改為您的實際設定
# cp .env.example .env

# ================================================
# Notifier 路徑設定 (可選)
# ================================================

# Notifier 安裝路徑 (外部安裝模式時設定)
# 若使用 lib/notifier/ 或內嵌模式則不需設定
# NOTIFIER_PATH=/path/to/notifier

# ================================================
# 通知設定
# ================================================

# 是否啟用通知 (true/false)
NOTIFY_ENABLED=true

# 通知渠道 (目前支援: google_chat)
NOTIFY_CHANNEL=google_chat

# 通知策略
# - all: 成功與失敗都通知
# - failure_only: 僅失敗時通知
NOTIFY_STRATEGY=all

# ================================================
# Google Chat Webhook 設定
# ================================================

# Google Chat Webhook URL
# 取得方式：
#   1. 開啟 Google Chat
#   2. 進入要接收通知的空間（Space）
#   3. 點擊空間名稱旁的下拉選單
#   4. 選擇「管理 Webhook」
#   5. 點擊「新增 Webhook」
#   6. 輸入名稱（如：SendDelivery 通知）
#   7. 複製產生的 Webhook URL
#
# 格式範例:
# https://chat.googleapis.com/v1/spaces/XXXXXXXXXX/messages?key=XXXXXXXX&token=XXXXXXXX

GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# ================================================
# Log 設定
# ================================================

# Log 檔案目錄 (相對於專案根目錄)
LOG_DIRECTORY=log

# Log 檔案名稱
LOG_FILENAME=SendDelivery.log

# ================================================
# 進階設定
# ================================================

# HTTP 請求超時時間 (秒)
NOTIFY_TIMEOUT=30

# 是否顯示詳細除錯訊息
DEBUG_MODE=false

# ================================================
# 服務健康監控設定 (Service Health Monitoring)
# ================================================
# 由 monitorServices.php 使用，詳見 docs/SERVICE_MONITOR.md。
# 沿用上方既有的 NOTIFY_ENABLED / GOOGLE_CHAT_WEBHOOK / NOTIFY_TIMEOUT
# 作為 Google Chat 傳送設定；NOTIFY_STRATEGY 不影響服務監控通知。

# 是否啟用服務監控 (true/false)
# 設為 false 為緊急停用開關：check/report 皆不執行，但既有監控資料保留
SERVICE_MONITOR_ENABLED=true

# 服務監控使用的時區
SERVICE_MONITOR_TIMEZONE=Asia/Taipei

# 主機識別名稱，用於告警/日報標題區分不同主機的來源
# 留空時預設使用系統主機名稱 (gethostname())
SERVICE_MONITOR_HOST_NAME=

# 監控資料 (state.json、每日 log、日報 sent marker) 儲存路徑
# 相對於 monitorServices.php 所在目錄
MONITOR_STORAGE_PATH=storage/service-monitor

# cron 排程間隔 (分鐘)，用於日報推算單日預期檢查次數
MONITOR_INTERVAL_MINUTES=5

# 連續異常達此次數才判定為異常並發送告警
MONITOR_FAILURE_THRESHOLD=1

# 連續成功達此次數才判定為恢復
MONITOR_RECOVERY_THRESHOLD=1

# 持續異常期間的重複提醒間隔 (分鐘)，設為 0 停用重複提醒
MONITOR_REPEAT_ALERT_MINUTES=60

# 監控紀錄保留天數，超過此天數的每日 log 檔案會被清除
MONITOR_RETENTION_DAYS=30

# 單次 check 執行的整批時間預算 (秒)
# 必須小於 MONITOR_INTERVAL_MINUTES 換算的秒數，避免下一輪 cron 重疊；
# 預算耗盡時，尚未執行到的服務會直接標記為 unknown（理由：預算耗盡）
MONITOR_CHECK_TOTAL_BUDGET_SECONDS=240

# 受監控服務清單 (有序、逗號分隔)；缺漏或空白視為明確設定錯誤，
# 不會被靜默當成「不監控任何服務」
# 新增服務只需在此加入 key，並補上對應的
# MONITOR_SERVICE_<KEY>_TYPE (http/command/mysql) 與該型別所需設定，
# 不需要修改任何 PHP 程式碼
MONITOR_SERVICES=apache,mysql

# ------------------------------------------------
# apache（http 型別；未設定 MONITOR_SERVICE_APACHE_TYPE 時預設為 http）
# 以下為既有 vm2 部署慣例的扁平命名 fallback：
# 命名空間設定 MONITOR_SERVICE_APACHE_* 優先，缺席時才退回讀取這些變數
# ------------------------------------------------

# 健康檢查 URL
# 注意：vm2 實測預設路徑會回應 403（非 200），部署時務必依實際環境調整
# 此 URL 或下方狀態碼範圍，兩者都需要能被覆寫
APACHE_HEALTHCHECK_URL=http://127.0.0.1/
APACHE_HEALTHCHECK_HOST_HEADER=
APACHE_EXPECTED_BODY_CONTAINS=
APACHE_HTTP_MIN_STATUS=200
APACHE_HTTP_MAX_STATUS=399
APACHE_CONNECT_TIMEOUT=5
APACHE_REQUEST_TIMEOUT=10

# ------------------------------------------------
# mysql（mysql 型別；未設定 MONITOR_SERVICE_MYSQL_TYPE 時預設為 mysql）
# ------------------------------------------------

# 健康檢查模式：ping（mysqladmin ping）或 query（SELECT 1）
MYSQL_HEALTHCHECK_MODE=ping
MYSQLADMIN_PATH=/opt/lampp/bin/mysqladmin
MYSQL_CLIENT_PATH=/opt/lampp/bin/mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SOCKET=
MYSQL_CONNECT_TIMEOUT=5

# query 模式才需要；憑證檔權限必須是 0600，密碼絕不會出現在命令列參數
# MYSQL_DEFAULTS_EXTRA_FILE=/path/to/.my-monitor.cnf
MYSQL_DEFAULTS_EXTRA_FILE=

# ------------------------------------------------
# LAMPP 專屬診斷（僅附加到 apache 服務結果的 diagnostic 欄位，
# 不獨立驅動任何健康判定；與上方 APACHE_HEALTHCHECK_URL 檢查各自獨立）
# ------------------------------------------------
LAMPP_ROOT=/opt/lampp
LAMPP_STATUS_CHECK_ENABLED=true
LAMPP_STATUS_STRICT=false

# ------------------------------------------------
# 新增其他服務範例（只需設定，不需修改核心程式碼）
# ------------------------------------------------
# MONITOR_SERVICES=apache,mysql,redis
# MONITOR_SERVICE_REDIS_TYPE=command
# MONITOR_SERVICE_REDIS_BINARY_PATH=/usr/bin/redis-cli
# MONITOR_SERVICE_REDIS_ARGS=ping
# MONITOR_SERVICE_REDIS_EXPECTED_OUTPUT_CONTAINS=PONG
