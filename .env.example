# ================================================
# Notification Service 環境變數配置範本
# ================================================
# 複製此檔案為 .env 並修改為您的實際設定
# cp .env.example .env

# ================================================
# Notifier 路徑設定 (可選)
# ================================================

# Notifier 安裝路徑 (外部安裝模式時設定)
# 若使用 lib/notifier/ 或內嵌模式則不需設定
# NOTIFIER_PATH=/path/to/notifier

# ================================================
# 通知設定
# ================================================

# 是否啟用通知 (true/false)
NOTIFY_ENABLED=true

# 通知渠道 (目前支援: google_chat)
NOTIFY_CHANNEL=google_chat

# 通知策略
# - all: 成功與失敗都通知
# - failure_only: 僅失敗時通知
NOTIFY_STRATEGY=all

# ================================================
# Google Chat Webhook 設定
# ================================================

# Google Chat Webhook URL
# 取得方式：
#   1. 開啟 Google Chat
#   2. 進入要接收通知的空間（Space）
#   3. 點擊空間名稱旁的下拉選單
#   4. 選擇「管理 Webhook」
#   5. 點擊「新增 Webhook」
#   6. 輸入名稱（如：SendDelivery 通知）
#   7. 複製產生的 Webhook URL
#
# 格式範例:
# https://chat.googleapis.com/v1/spaces/XXXXXXXXXX/messages?key=XXXXXXXX&token=XXXXXXXX

GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# ================================================
# Log 設定
# ================================================

# Log 檔案目錄 (相對於專案根目錄)
LOG_DIRECTORY=log

# Log 檔案名稱
LOG_FILENAME=SendDelivery.log

# ================================================
# 進階設定
# ================================================

# HTTP 請求超時時間 (秒)
NOTIFY_TIMEOUT=30

# 是否顯示詳細除錯訊息
DEBUG_MODE=false
