{
    "name": "your-org/notifier",
    "description": "通用通知服務框架，支援 Google Chat Webhook，相容 PHP 5.6",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=5.6",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Notifier\\": "src/"
        },
        "files": [
            "src/utility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Notifier\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-text"
    }
}
